buildscript {
    ext {
        build_gradle_version = "@@TOOLING_API_TEST_AGP_VERSION@@"
    }
    
    project.ext {
        compileSdk = 33
        buildTools = "33.0.0"
        appId = "dev.mutwakil.test.app"
        minSdk = 21
        targetSdk = 33
        versionCode = 100
        versionName = "1.0.0"
    }
    
    repositories {
        google ()
        mavenCentral ()
    }
    dependencies {
        classpath "com.android.tools.build:gradle:$build_gradle_version"
    }
    
}
allprojects {
    repositories {
        mavenCentral ()
        google ()
    }
}

task clean (type: Delete) {
    delete rootProject.buildDir
}
